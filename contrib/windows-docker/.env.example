# Copy to .env (git-ignored) and fill in.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com
# Pinned versions; bump them, then: docker compose build --pull && docker compose up -d
COPILOT_VERSION=1.0.98
PDO_VERSION=1.126.0
# Uncomment if live terminals in the UI don't connect
# PDO_ALLOWED_WS_ORIGINS=http://localhost:5172,http://127.0.0.1:5172
